# Madison County Title Plant - Local Database Credentials
# Copy this file to .db_credentials and update with your actual password:
#   cp .db_credentials.example .db_credentials
#
# Then source it before running scripts:
#   source index_database/.db_credentials

export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=madison_county_index
export DB_USER=madison_index_app
export DB_PASSWORD=your_password_here
